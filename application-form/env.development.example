# 開発環境用環境変数設定例
# このファイルを参考に、.envファイルを作成してください（.envファイルは.gitignoreされています）
# 
# 作成方法:
# cp env.development.example .env
# その後、実際の値を設定してください

# データベース設定（開発環境用）
# ローカルPostgreSQLの場合の例
DATABASE_URL="postgresql://postgres:password@localhost:5432/justjoin"

# または、Cloud SQL Proxyを使用する場合
# DATABASE_URL="postgresql://postgres:password@localhost:5432/justjoin?host=/cloudsql/justjoin-platform:asia-northeast1:justjoin"

# GCP Cloud Storage設定（開発環境では使用しない場合もあり）
GOOGLE_CLOUD_PROJECT_ID="justjoin-platform"
GOOGLE_CLOUD_STORAGE_BUCKET="justjoin-platform-match-job-documents"
GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"

# メール送信サービス設定（開発環境では使用しない場合もあり）
EMAIL_SERVICE=gmail
GMAIL_USER=inside.justjoin@gmail.com
GMAIL_PASSWORD=your_app_password_here

# 管理者メールアドレス
ADMIN_EMAIL=admin@justjoin.jp

# Google OAuth 2.0設定（SSO用）
# Google Cloud ConsoleでOAuth 2.0クライアントIDを作成し、以下の値を設定してください
# 1. https://console.cloud.google.com/apis/credentials にアクセス
# 2. 「認証情報を作成」→「OAuth 2.0 クライアントID」を選択
# 3. アプリケーションの種類：「ウェブアプリケーション」を選択
# 4. 承認済みのリダイレクトURIに以下を追加：
#    http://localhost:3001/api/auth/google/callback
# 5. 作成されたクライアントIDとシークレットを以下に設定
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"

# Server Configuration
PORT=3001
NODE_ENV="development"

# Security
JWT_SECRET="justjoin-jwt-secret-2024-dev"
SESSION_SECRET="justjoin-session-secret-2024-dev"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"

# Logging
LOG_LEVEL="debug"
LOG_FILE="./logs/app.log"

# ドメイン設定（開発環境）
DOMAIN="localhost"
BASE_URL="http://localhost:5173"

# reCAPTCHA設定（オプション）
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"
VITE_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"

